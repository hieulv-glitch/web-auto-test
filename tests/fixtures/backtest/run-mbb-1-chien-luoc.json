{"id": 6, "symbols": ["MBB"], "scope_label": "MBB", "from_date": "15/10/2023", "to_date": "15/10/2026", "capital": 100000000, "engine_version": 2, "criterion_error": null, "manifest_hash": "66bd3eeae8dcdb55", "ran_at": "2026-10-15T06:49:01.000Z", "pinned": false, "tier2_purged": false, "strategies": [{"strategy_key": "s0", "strategy_no": 1, "title": "Chandelier Exit", "snapshot": {"buy": {"size": {"mode": "fixed_amount", "numValue": 100000000}, "weights": [1], "excludes": [], "triggers": [{"id": "M1", "code": "// Tín hiệu chiến lược Chandelier Exit, lấy nguyên từ engine.js nhánh feature/backtest.\nconst bars = d.nen.map(x => ({ open: x.o, high: x.h, low: x.l, close: x.c, volume: x.v }));\nfunction atr(bars, period) {\n  const out = new Array(bars.length).fill(null);\n  const tr = bars.map((b, i) => {\n    if (i === 0) return b.high - b.low;\n    const pc = bars[i - 1].close;\n    return Math.max(b.high - b.low, Math.abs(b.high - pc), Math.abs(b.low - pc));\n  });\n  if (bars.length <= period) return out;\n  let prev = 0;\n  for (let i = 1; i <= period; i++) prev += tr[i];\n  prev /= period;\n  out[period] = prev;\n  for (let i = period + 1; i < bars.length; i++) {\n    prev = (prev * (period - 1) + tr[i]) / period;\n    out[i] = prev;\n  }\n  return out;\n}\nfunction chandelierExit(bars, period, multiplier) {\n  const a = atr(bars, period);\n  const close = bars.map((b) => b.close);\n  const longStop = new Array(bars.length).fill(null);\n  const shortStop = new Array(bars.length).fill(null);\n  const dir = new Array(bars.length).fill(null);\n  let d = 1;\n  for (let i = 0; i < bars.length; i++) {\n    if (a[i] == null || i < period) continue;\n    let hh = -Infinity;\n    let ll = Infinity;\n    for (let j = i - period + 1; j <= i; j++) {\n      if (close[j] > hh) hh = close[j];\n      if (close[j] < ll) ll = close[j];\n    }\n    let ls = hh - multiplier * a[i];\n    let ss = ll + multiplier * a[i];\n    if (longStop[i - 1] != null && close[i - 1] > longStop[i - 1]) {\n      ls = Math.max(ls, longStop[i - 1]);\n    }\n    if (shortStop[i - 1] != null && close[i - 1] < shortStop[i - 1]) {\n      ss = Math.min(ss, shortStop[i - 1]);\n    }\n    longStop[i] = ls;\n    shortStop[i] = ss;\n    if (shortStop[i - 1] != null && close[i] > shortStop[i - 1]) d = 1;\n    else if (longStop[i - 1] != null && close[i] < longStop[i - 1]) d = -1;\n    dir[i] = d;\n  }\n  return { longStop, shortStop, dir };\n}\nconst signals = function (bars, p) {\n      const { dir } = chandelierExit(bars, p.period, p.multiplier);\n      return bars.map((_, i) => {\n        if (i === 0 || dir[i] == null || dir[i - 1] == null) return 0;\n        if (dir[i - 1] === -1 && dir[i] === 1) return 1;\n        if (dir[i - 1] === 1 && dir[i] === -1) return -1;\n        return 0;\n      });\n    };\nconst s = signals(bars, ts);\nreturn s[s.length - 1] === 1;", "title": "Tín hiệu mua Chandelier Exit", "custom": true, "params": [{"title": "period", "caption": "Số phiên", "gia_tri": 22}, {"title": "multiplier", "caption": "Hệ số ATR", "gia_tri": 3}], "formula": "Chandelier Exit vừa chuyển sang giữ lệnh mua", "connector": "and"}], "fillPrice": "next_close", "allocation": "equal", "maxEntries": 1}, "name": "Chandelier Exit", "sell": {"confirm": {"enabled": false}, "signals": [{"id": "B1", "code": "// Tín hiệu chiến lược Chandelier Exit, lấy nguyên từ engine.js nhánh feature/backtest.\nconst bars = d.nen.map(x => ({ open: x.o, high: x.h, low: x.l, close: x.c, volume: x.v }));\nfunction atr(bars, period) {\n  const out = new Array(bars.length).fill(null);\n  const tr = bars.map((b, i) => {\n    if (i === 0) return b.high - b.low;\n    const pc = bars[i - 1].close;\n    return Math.max(b.high - b.low, Math.abs(b.high - pc), Math.abs(b.low - pc));\n  });\n  if (bars.length <= period) return out;\n  let prev = 0;\n  for (let i = 1; i <= period; i++) prev += tr[i];\n  prev /= period;\n  out[period] = prev;\n  for (let i = period + 1; i < bars.length; i++) {\n    prev = (prev * (period - 1) + tr[i]) / period;\n    out[i] = prev;\n  }\n  return out;\n}\nfunction chandelierExit(bars, period, multiplier) {\n  const a = atr(bars, period);\n  const close = bars.map((b) => b.close);\n  const longStop = new Array(bars.length).fill(null);\n  const shortStop = new Array(bars.length).fill(null);\n  const dir = new Array(bars.length).fill(null);\n  let d = 1;\n  for (let i = 0; i < bars.length; i++) {\n    if (a[i] == null || i < period) continue;\n    let hh = -Infinity;\n    let ll = Infinity;\n    for (let j = i - period + 1; j <= i; j++) {\n      if (close[j] > hh) hh = close[j];\n      if (close[j] < ll) ll = close[j];\n    }\n    let ls = hh - multiplier * a[i];\n    let ss = ll + multiplier * a[i];\n    if (longStop[i - 1] != null && close[i - 1] > longStop[i - 1]) {\n      ls = Math.max(ls, longStop[i - 1]);\n    }\n    if (shortStop[i - 1] != null && close[i - 1] < shortStop[i - 1]) {\n      ss = Math.min(ss, shortStop[i - 1]);\n    }\n    longStop[i] = ls;\n    shortStop[i] = ss;\n    if (shortStop[i - 1] != null && close[i] > shortStop[i - 1]) d = 1;\n    else if (longStop[i - 1] != null && close[i] < longStop[i - 1]) d = -1;\n    dir[i] = d;\n  }\n  return { longStop, shortStop, dir };\n}\nconst signals = function (bars, p) {\n      const { dir } = chandelierExit(bars, p.period, p.multiplier);\n      return bars.map((_, i) => {\n        if (i === 0 || dir[i] == null || dir[i - 1] == null) return 0;\n        if (dir[i - 1] === -1 && dir[i] === 1) return 1;\n        if (dir[i - 1] === 1 && dir[i] === -1) return -1;\n        return 0;\n      });\n    };\nconst s = signals(bars, ts);\nreturn s[s.length - 1] === -1;", "title": "Tín hiệu bán Chandelier Exit", "custom": true, "params": [{"title": "period", "caption": "Số phiên", "gia_tri": 22}, {"title": "multiplier", "caption": "Hệ số ATR", "gia_tri": 3}], "formula": "giá vừa thủng ngưỡng Chandelier Exit"}], "weights": [1], "intraday": false, "maxExits": 1, "fillPrice": "next_close", "allocation