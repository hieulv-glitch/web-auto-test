# URL môi trường web cần test (staging/production)
BASE_URL=https://staging.example.com

# Tài khoản đăng nhập dùng cho test (nếu app yêu cầu login)
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# --- Google Sheets (Service Account) ---
# ID lấy từ URL sheet: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=
# Tên tab (sheet) chứa danh sách testcase, ví dụ "Testcases"
GOOGLE_SHEETS_TAB_NAME=Testcases
# Email của service account (dạng ...@<project>.iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Private key lấy từ file JSON tải về khi tạo service account (giữ nguyên \n)
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
